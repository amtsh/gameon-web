# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Google sign-in (Supabase Dashboard → Authentication → Providers → Google):
# 1. Enable Google and add OAuth client ID + secret from Google Cloud Console
# 2. Authorized redirect URI in Google: https://<project-ref>.supabase.co/auth/v1/callback
# 3. Site URL in Supabase Auth: http://localhost:3000 (add production URL when deployed)
# 4. Redirect URLs: http://localhost:3000/auth/callback

# Never expose in the browser:
# SUPABASE_SERVICE_ROLE_KEY=
