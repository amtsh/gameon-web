{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameon-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gameon-web"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "nextjs-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Workers cache (Wrangler >= 4.69). Zone Cache Rules do not apply here;
  // edge TTL is driven by response headers on each route.
  //
  // OG images (see lib/seo/og-font.ts):
  //   GET /opengraph-image             — static build asset (ASSETS)
  //   GET /g/:token/opengraph-image    — dynamic; Cache-Control: public, max-age=3600
  "cache": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "gameonsite.com",
      "zone_name": "gameonsite.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://byvfiqshsclydlvhfrim.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_VCVpll2kxCZ3LF7Ckk2GKQ_LWhOaKb5"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
